# daizee-mcp runs with ZERO configuration. Everything below is optional.

# Port for the local server (default 8787)
# PORT=8787

# Demo controls (advance time, reset). On by default locally; set 0 to disable.
# DAIZEE_DEMO=1

# Extra browser origins allowed to call the server (localhost is always allowed).
# DAIZEE_ALLOWED_ORIGINS=https://your-demo.web.app

# Used only by the demo page's "assistant brain" (added with the simulator).
# Never commit real keys.
# GEMINI_API_KEY=

# Which Gemini model the demo page's assistant brain uses (default: gemini-3.1-flash-lite).
# Older ids such as gemini-2.5-flash are retired for new API keys.
# GEMINI_MODEL=gemini-3.1-flash-lite

# ── Connect to the real DayZer0 app (optional) ───────────────────────────────
# Default is fictional in-memory data. STORE=firestore reads and writes the app's
# Firestore in the app's own shapes. See README "Connected to the DayZer0 app".
# STORE=firestore
# FIREBASE_PROJECT_ID=
# Allowlist: x-daizee-user name = Firebase uid. Nothing else is reachable. Use a demo account.
# DAIZEE_ALLOWED_UIDS=demo=
# A service account key file, kept OUTSIDE the repo (not needed for the emulator).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Required to touch a real project. Leave unset during development and use the emulator
# (FIRESTORE_EMULATOR_HOST is set for you by `firebase emulators:exec`).
# DAIZEE_ALLOW_LIVE_FIRESTORE=1
