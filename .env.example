# daizee-mcp runs with ZERO configuration. Everything below is optional.

# Port for the local server (default 8787)
# PORT=8787

# Demo controls (advance time, reset). On by default locally; set 0 to disable.
# DAIZEE_DEMO=1

# Extra browser origins allowed to call the server (localhost is always allowed).
# DAIZEE_ALLOWED_ORIGINS=https://your-demo.web.app

# Used only by the demo page's "assistant brain" (added with the simulator).
# Never commit real keys.
# GEMINI_API_KEY=

# Which Gemini model the demo page's assistant brain uses (default: gemini-3.1-flash-lite).
# Older ids such as gemini-2.5-flash are retired for new API keys.
# GEMINI_MODEL=gemini-3.1-flash-lite
