{
  "name": "daizee-mcp",
  "version": "0.1.0",
  "description": "Daizee health memory as an MCP server: expiring, safety-first memory that lives in the service, not in the assistant.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p simulator/tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "start": "tsx src/server/main.ts",
    "demo": "npm run build:sim && tsx src/server/main.ts",
    "test": "vitest run",
    "lint:voice": "tsx tools/voice-lint/cli.ts",
    "build:sim": "vite build --config simulator/vite.config.ts",
    "dev:sim": "vite --config simulator/vite.config.ts",
    "eval:live": "tsx evals/orchestrator.ts",
    "build:functions": "node functions/build.mjs",
    "deploy": "firebase deploy --only functions,hosting --project daizee-mcp-demo --account fazilnazkolambil@gmail.com",
    "trace:update": "WRITE_WIRE_TRACE=1 vitest run tests/contract.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
